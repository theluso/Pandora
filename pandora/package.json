    "dev": "node --disable-warning=ExperimentalWarning src/cli.js serve",
    "serve": "node --disable-warning=ExperimentalWarning src/cli.js serve",
    "ingest": "node --disable-warning=ExperimentalWarning src/cli.js ingest",
    "worker": "node --disable-warning=ExperimentalWarning src/cli.js worker",
    "reset": "node --disable-warning=ExperimentalWarning src/cli.js reset",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
