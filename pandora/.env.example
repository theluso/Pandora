# ─────────────────────────────────────────────────────────────
# Pandora Events — configuration
# Copy this file to `.env`. Every value below has a working
# default, so you can start with an empty .env and it will run.
# ─────────────────────────────────────────────────────────────

# Where the web dashboard and the agent API listen.
PORT=4180
HOST=127.0.0.1

# Where the database file lives (SQLite = a single file on disk).
DATABASE_PATH=./data/pandora.db

# "live"    → really fetch the public feeds over the internet
# "fixture" → replay the recorded samples in ./fixtures (no internet needed)
INGEST_MODE=fixture

# How often the background worker polls sources, in seconds.
POLL_INTERVAL_SECONDS=300

# Signs every outgoing webhook so receivers can verify it came from you.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SIGNING_SECRET=change-me-in-production

# Admin key for the curation dashboard and for minting subscriber keys.
# Leave blank to auto-generate one on first run (printed to the console).
ADMIN_API_KEY=

# Outgoing webhook behaviour
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# Optional: a contact address sent as part of the User-Agent when polling
# public feeds. Several government feeds ask for this as a courtesy.
INGEST_CONTACT=pandora@example.com
